# Environment (development | test | production)
NODE_ENV=development

# Server Binding
HOST=127.0.0.1
PORT=3001

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# CORS (comma separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentops

# AI Provider
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Browser Engine
MAX_CONCURRENT_SESSIONS=5
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_NAVIGATION_TIMEOUT_MS=30000

# Explorer
MAX_EXPLORATION_PAGES=5
MAX_EXPLORATION_DEPTH=2

# QA Test Generator
MAX_TESTS_PER_RUN=20
MAX_STEPS_PER_TEST=10
MAX_ASSERTIONS_PER_TEST=5

# QA Execution Engine
MAX_RUN_TIMEOUT_MS=300000
MAX_TEST_TIMEOUT_MS=30000

# B12 Security Hardening Defaults
RATE_LIMIT_READ_MAX=100
RATE_LIMIT_HEAVY_MAX=20
RATE_LIMIT_WINDOW_MS=60000
EVIDENCE_STORAGE_DIR=./evidence
MAX_EVIDENCE_SIZE_MB=10
MAX_SSE_SUBSCRIBERS=10
